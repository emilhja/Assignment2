# Use local to target a llama.cpp / LM Studio / OpenAI-compatible server.
# Example for llama-server on host port 8080:
# LLM_PROVIDER_ORDER=local
# LOCAL_LLM_BASE_URL=http://127.0.0.1:8080
# LOCAL_LLM_MODEL=local-model
LLM_PROVIDER_ORDER=groq,openrouter

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

LOCAL_LLM_BASE_URL=http://127.0.0.1:8080
LOCAL_LLM_MODEL=local-model
LOCAL_LLM_API_KEY=

# Per-request guardrails — prevent local-LLM runaway generations from hanging the agent.
# Set either to 0 to disable that bound.
LLM_MAX_TOKENS=2048
LLM_REQUEST_TIMEOUT_SECONDS=120

# Uncomment to print raw model responses, observations, parser guidance, and step numbers.
# AGENT_DEBUG=1

# Optional local overrides
# AGENT_WORKSPACE=workspace
# AGENT_SESSION_DB=data/session_history.sqlite3

# Better models for final/demo and fallback, but more expensive to run
# GROQ_MODEL=openai/gpt-oss-20b

# Development model: llama-3.1-8b-instant
# Final/demo model: openai/gpt-oss-20b
# Fallback stronger model: openai/gpt-oss-120b
