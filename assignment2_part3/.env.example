# Agent identity (P3.7 unique agent name)
AGENT_ID=alice
AGENT_DISPLAY_NAME=alice-swe
# Optional extra handles this agent should also reply to (comma-separated).
# Matched the same way as AGENT_DISPLAY_NAME: `@<alias>` substring + word-boundary.
# Useful when others address you by your real name on the public hub.
# Example: AGENT_ALIASES=Emil Hjärtfors,Emil
AGENT_ALIASES=

# Mode: stub (local stdin/stdout JSON) or runpod
# To join the TH25 hub: set AGENT_MODE=runpod and pick a unique
# AGENT_DISPLAY_NAME (format: yourname-rolename; see th25-hub-connection.md).
AGENT_MODE=stub

# Budget / rate limit (P3.5)
# Generous local-LLM/paid-provider defaults. Lower these for tight hosted quotas.
AGENT_TPM_LIMIT=100000
AGENT_RPM_LIMIT=30
AGENT_TOTAL_TOKEN_LIMIT=2000000

# Reply policy (P3.6)
REPLY_COOLDOWN_SECONDS=30
REPLY_MAX_BROADCAST=1
REPLY_BROADCAST_WINDOW_SECONDS=300

# Local hub (docker-compose local-hub service). Any non-empty value works
# for local development; LOCAL_HUB_PASSWORD and RUNPOD_CHAT_PASSWORD must
# match so the agents can authenticate against the local hub.
LOCAL_HUB_PASSWORD=dev-shared
# If a local LLM already uses host port 8080, set this to another host port.
LOCAL_HUB_PORT=8090

# RunPod transport — required when AGENT_MODE=runpod
RUNPOD_CHAT_URL=
RUNPOD_CHAT_PASSWORD=dev-shared
# Fallback name for RUNPOD_CHAT_PASSWORD (kept for backwards compatibility)
RUNPOD_CHAT_TOKEN=
# Poll interval in seconds for GET /api/messages (hub rate-limits at 1 req/s)
RUNPOD_CHAT_POLL_INTERVAL=4

# Per-agent LLM provider (read by docker-compose.yml and forwarded as LLM_PROVIDER_ORDER
# per service). Local-first keeps the two-agent local demo responsive; put `groq`
# first only when you explicitly want to exercise cloud fallback behavior.
ALICE_LLM_PROVIDER_ORDER=local
BOB_LLM_PROVIDER_ORDER=local,groq
# Single remote Docker bot provider order. For OpenRouter's OpenAI-hosted
# 4o-mini route, use `openrouter` with OPENROUTER_MODEL below.
AGENT_LLM_PROVIDER_ORDER=openrouter

# Hosted-provider creds — required for any agent whose provider order includes
# `groq` or `openrouter`.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
LOCAL_LLM_BASE_URL=http://127.0.0.1:8080
LOCAL_LLM_MODEL=local-model
LOCAL_LLM_API_KEY=

# Per-request guardrails — prevent local-LLM runaway generations from hanging agents.
# Set either to 0 to disable that bound.
LLM_MAX_TOKENS=4096
LLM_REQUEST_TIMEOUT_SECONDS=120

# `[hub<-]`/`[hub->]` console snippet length (default 120). 0 = no truncation.
HUB_LOG_SNIPPET_CHARS=120
